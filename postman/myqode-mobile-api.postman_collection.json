{
  "info": {
    "name": "myQode Mobile API",
    "description": "Complete API collection for the myQode mobile backend (41 endpoints across 9 folders).\n\n**How to use:**\n1. Set `baseUrl` variable to your environment URL.\n2. Run **Auth > Login** first — the test script auto-saves `{{token}}` so all subsequent requests are authenticated automatically.\n3. Set `{{accountId}}` to a real client code (e.g. QAW00038).\n4. For combined/aggregate endpoints use `{{ownerId}}` (ownerid or groupid from pms_clients_master).\n\n**Variables:**\n- `baseUrl` — API base URL\n- `token` — JWT Bearer token (auto-set by Login)\n- `accountId` — individual client code\n- `ownerId` — owner/group ID for combined endpoints\n- `orderId` — Cashfree order ID (auto-set by Create Order)\n- `subscriptionId` — Cashfree SIP subscription ID (auto-set by Setup SIP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",        "value": "https://myqode.qodeinvest.com/api/mobile", "description": "Base URL — swap to dev tunnel for local testing" },
    { "key": "token",          "value": "", "description": "JWT Bearer token — auto-set by the Login request test script" },
    { "key": "accountId",      "value": "QAW00038", "description": "Default individual account code" },
    { "key": "ownerId",        "value": "", "description": "Owner or group ID for combined portfolio requests" },
    { "key": "orderId",        "value": "", "description": "Cashfree order ID — auto-set after Create Order" },
    { "key": "subscriptionId", "value": "", "description": "Cashfree SIP subscription ID — auto-set after Setup SIP" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication. Run Login first — the test script saves {{token}} so every other request authenticates automatically.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) {",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    console.log('✅ Token saved');",
                  "    console.log('   User:', j.user?.name, '|', j.user?.email);",
                  "    console.log('   Accounts:', (j.user?.accountCodes || []).join(', '));",
                  "  }",
                  "} else {",
                  "  console.error('❌ Login failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ashwinagarwal1@gmail.com\",\n  \"password\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Issues a JWT Bearer token.\n\n- In `NODE_ENV=development` the password can be empty for any real account (dev bypass).\n- In production a valid bcrypt password is required.\n- Test script auto-saves the token to `{{token}}`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "👤 Admin",
      "description": "Super-admin only endpoints. Token must belong to isSuperAdmin=true (karan@qodeinvest.com or SUPER_ADMIN_EMAIL env var).",
      "item": [
        {
          "name": "List All Clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/clients?search=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "clients"],
              "query": [
                { "key": "search", "value": "", "description": "Filter by name, email or client code" },
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" }
              ]
            },
            "description": "Returns all client owner groups for the super-admin master view. Paginated."
          },
          "response": []
        },
        {
          "name": "Analytics Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics"],
              "query": [
                { "key": "days",     "value": "30", "description": "Lookback window in days" },
                { "key": "event",    "value": "", "description": "Filter by event name", "disabled": true },
                { "key": "platform", "value": "", "description": "ios | android", "disabled": true }
              ]
            },
            "description": "Returns analytics event summary for the admin dashboard. Super-admin only."
          },
          "response": []
        },
        {
          "name": "Impersonate Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) {",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    console.log('✅ Impersonation token saved. Acting as:', j.user?.name);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientCode\": \"{{accountId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/impersonate",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "impersonate"]
            },
            "description": "Issues a new JWT scoped to the given clientCode. Super-admin only. Test script replaces {{token}} with the impersonation token."
          },
          "response": []
        }
      ]
    },
