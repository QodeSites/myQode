{
  "info": {
    "name": "Qode Mobile API",
    "description": "All mobile API endpoints for the Qode PMS investor app.\n\n## Setup\n1. Run the **Login** request first\n2. The `token` is automatically saved to the `jwt_token` collection variable\n3. All subsequent requests use that token automatically via the collection-level Authorization header\n\n## Variables\n- `base_url` — change to your production URL when deploying\n- `jwt_token` — auto-set after Login\n- `account_id` — set to your account code (e.g. QFH0008)",
    "_postman_id": "qode-mobile-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://f2lxldmp-2069.inc1.devtunnels.ms",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "QFH0008",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('jwt_token', res.token);",
                  "  console.log('✅ Token saved. accountCodes:', res.user?.accountCodes);",
                  "  if (res.user?.accountCodes?.[0]) {",
                  "    pm.collectionVariables.set('account_id', res.user.accountCodes[0]);",
                  "    console.log('✅ account_id set to:', res.user.accountCodes[0]);",
                  "  }",
                  "} else {",
                  "  console.error('❌ Login failed:', res);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"yourpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates an investor and returns a 30-day JWT.\n\nThe test script automatically saves the token to `jwt_token` and sets `account_id` to the first account code."
          }
        }
      ]
    },
