    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.orderId) {",
                  "  pm.collectionVariables.set(\"order_id\", res.orderId);",
                  "  console.log(\"✅ order_id saved:\", res.orderId);",
                  "  console.log(\"   paymentSessionId:\", res.paymentSessionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"accountId\": \"{{account_id}}\",\n  \"orderType\": \"ONE_TIME\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/payments/create-order",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "payments",
                "create-order"
              ]
            },
            "description": "Creates a Cashfree order. Returns paymentSessionId to pass to the React Native Cashfree SDK."
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/mobile/payments/verify?orderId={{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "payments",
                "verify"
              ],
              "query": [
                {
                  "key": "orderId",
                  "value": "{{order_id}}"
                }
              ]
            },
            "description": "Call after Cashfree SDK completes. Returns live payment status and syncs DB."
          }
        },
        {
          "name": "Investment Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/mobile/payments/investment-status?accountId={{account_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "payments",
                "investment-status"
              ],
              "query": [
                {
                  "key": "accountId",
                  "value": "{{account_id}}"
                }
              ]
            },
            "description": "Returns full investment lifecycle for all orders. Shows PENDING_PAYMENT → PAYMENT_SUCCESS → SETTLED → DEPLOYED with human-readable messages and timeline."
          }
        }
      ]
    },
